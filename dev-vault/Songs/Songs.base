filters:
  and:
    - note.type == "guitar_song"
    - file.ext == "md"
properties:
  file.name:
    displayName: Song
views:
  - type: table
    name: Learning now
    filters:
      or:
        - note.status == "learning"
        - note.status == "polishing"
    order:
      - file.name
      - artist
      - key
      - capo
      - tuning
      - difficulty
      - status
      - started
    sort:
      - property: started
        direction: ASC
  - type: table
    name: To start
    filters: note.status == "to_start"
    order:
      - file.name
      - artist
      - key
      - difficulty
      - source
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: By artist
    groupBy:
      property: artist
      direction: ASC
    order:
      - file.name
      - key
      - capo
      - tuning
      - difficulty
      - status
    sort:
      - property: title
        direction: ASC
  - type: table
    name: Learned
    filters: note.status == "learned"
    order:
      - file.name
      - artist
      - key
      - difficulty
      - learned
    sort:
      - property: learned
        direction: DESC
